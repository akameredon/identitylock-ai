{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "identitylock-ai",
  "main": "./cloudflare/worker.js",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
